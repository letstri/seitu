    "fumadocs-mdx": "^15.4.0",
    "fumadocs-twoslash": "^3.3.1",
    "fumadocs-ui": "^16.15.6",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "seitu": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "nitro": "^3.0.260603-beta",
