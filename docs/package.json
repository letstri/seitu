{
  "name": "docs",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "prebuild": "pnpm run docs:generate && cd ../seitu && pnpm run build",
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
