{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cd seitu && pnpm run build",
    "check-types": "pnpm -r run check-types",
    "format": "oxfmt --config ./oxfmt.config.ts --ignore-path .gitignore .",
    "format:check": "oxfmt --config ./oxfmt.config.ts --ignore-path .gitignore --check .",
    "lint": "oxlint --config ./oxlint.config.ts --ignore-path .gitignore --deny-warnings .",
    "lint:fix": "oxlint --config ./oxlint.config.ts --ignore-path .gitignore --fix --deny-warnings .",
    "prepare": "husky",
    "publish": "cd seitu && pnpm publish",
    "test": "cd seitu && pnpm run test",
    "update": "taze -r -I major"
  },
  "devDependencies": {
    "@types/jsdoc-to-markdown": "^7.0.6",
    "@types/node": "^26.4.1",
    "husky": "^9.1.7",
    "jsdoc-to-markdown": "^9.1.3",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.79.0",
    "taze": "^21.1.0",
    "typescript": "^6.0.3",
    "ultracite": "^7.10.8"
  },
  "packageManager": "pnpm@11.25.0"
}
