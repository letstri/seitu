{
  "name": "seitu",
  "displayName": "Seitu",
  "version": "1.2.0",
  "private": false,
  "keywords": [
    "react",
    "solid",
    "solid-js",
    "svelte",
    "tanstack-intent",
    "type-safe",
    "typescript",
    "utils",
    "vue"
  ],
  "homepage": "https://seitu.letstri.dev",
  "bugs": {
    "url": "https://github.com/letstri/seitu/issues"
  },
  "license": "MIT",
  "author": "Valerii Strilets",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/letstri/seitu.git",
    "directory": "seitu"
  },
  "funding": "https://github.com/sponsors/letstri",
  "files": [
    "!skills/sync-state.json",
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/core/index.mjs",
  "types": "./dist/core/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.mts",
      "import": "./dist/core/index.mjs",
      "default": "./dist/core/index.mjs"
    },
    "./core": {
      "types": "./dist/core/index.d.mts",
      "import": "./dist/core/index.mjs",
      "default": "./dist/core/index.mjs"
    },
    "./core/*": {
      "types": "./dist/core/*/index.d.mts",
      "import": "./dist/core/*/index.mjs",
      "default": "./dist/core/*/index.mjs"
    },
    "./web": {
      "types": "./dist/web/index.d.mts",
      "import": "./dist/web/index.mjs",
      "default": "./dist/web/index.mjs"
    },
    "./web/*": {
      "types": "./dist/web/*/index.d.mts",
      "import": "./dist/web/*/index.mjs",
      "default": "./dist/web/*/index.mjs"
    },
    "./react": {
      "types": "./dist/react/index.d.mts",
      "import": "./dist/react/index.mjs",
      "default": "./dist/react/index.mjs"
    },
    "./react/*": {
      "types": "./dist/react/*/index.d.mts",
      "import": "./dist/react/*/index.mjs",
      "default": "./dist/react/*/index.mjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.mts",
      "import": "./dist/vue/index.mjs",
      "default": "./dist/vue/index.mjs"
    },
    "./vue/*": {
      "types": "./dist/vue/*/index.d.mts",
      "import": "./dist/vue/*/index.mjs",
      "default": "./dist/vue/*/index.mjs"
    },
    "./solid": {
      "types": "./dist/solid/index.d.mts",
      "import": "./dist/solid/index.mjs",
      "default": "./dist/solid/index.mjs"
    },
    "./solid/*": {
      "types": "./dist/solid/*/index.d.mts",
      "import": "./dist/solid/*/index.mjs",
      "default": "./dist/solid/*/index.mjs"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.mts",
      "import": "./dist/svelte/index.mjs",
      "default": "./dist/svelte/index.mjs"
    },
    "./svelte/*": {
      "types": "./dist/svelte/*/index.d.mts",
      "import": "./dist/svelte/*/index.mjs",
      "default": "./dist/svelte/*/index.mjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.mts",
      "import": "./dist/utils/index.mjs",
      "default": "./dist/utils/index.mjs"
    },
    "./utils/*": {
      "types": "./dist/utils/*/index.d.mts",
      "import": "./dist/utils/*/index.mjs",
      "default": "./dist/utils/*/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "run-s check-types test build scripts:copy-readme skills:validate",
    "build": "tsdown",
    "test": "vitest run",
    "check-types": "tsc",
    "scripts:copy-readme": "cp ../README.md README.md",
    "skills:validate": "intent validate skills",
    "skills:stale": "intent stale skills"
  },
  "dependencies": {
    "fast-equals": "^6.0.3"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@standard-schema/spec": "^1.1.0",
    "@tanstack/intent": "^0.3.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.8",
    "solid-js": "^1.9.15",
    "svelte": "^5.57.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "solid-js": ">=1.9",
    "svelte": ">=5",
    "vue": ">=3.5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "intent": {
    "repo": "letstri/seitu",
    "docs": "../docs/content/docs"
  }
}
